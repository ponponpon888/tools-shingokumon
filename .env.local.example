# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Resend
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@shingokumon.com

# Claude API
ANTHROPIC_API_KEY=your_anthropic_api_key

# 使用モデル（未設定なら既定値を使う）
# OCR_MODEL=claude-opus-4-5
# TRANSLATION_MODEL=claude-haiku-4-5-20251001

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron の認証用。cron ルートはこれが無いと 503 を返す
CRON_SECRET=your_random_string

# レート制限（未設定なら既定値）。
# ローカル開発で引っかかる場合はここを大きくする。
# RATE_LIMIT_OCR_IP_PER_HOUR=5
# RATE_LIMIT_GENERATE_IP_PER_HOUR=5
# RATE_LIMIT_GENERATE_EMAIL_PER_DAY=3
